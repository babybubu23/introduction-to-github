<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>rajaluck33 - Color Prediction Game</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container">
        <h1>Welcome to Rajaluck33 Color Prediction Game!</h1>
        <p>Choose a color to predict!</p>
        
        <div class="buttons">
            <button onclick="startGame('Red')">Red</button>
            <button onclick="startGame('Blue')">Blue</button>
            <button onclick="startGame('Green')">Green</button>
            <button onclick="startGame('Yellow')">Yellow</button>
            <button onclick="startGame('Purple')">Purple</button>
        </div>
        
        <div id="result"></div>
        <div id="score">Score: 0</div>
    </div>
    
    <script src="script.js"></script>
</body>
</html>
